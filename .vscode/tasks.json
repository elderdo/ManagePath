{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "test",
			"command": "dotnet",
			"type": "process",
			"args": [
				"test"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "run (effective list)",
			"command": "dotnet",
			"type": "process",
			"args": [
				"run",
				"--",
				"path",
				"list",
				"-e",
				"-v",
				"-n"
			],
			"problemMatcher": "$msCompile"
		}
	]
}